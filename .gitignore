# Local runtime data. The SQLite database holds user accounts, OCLC
# credentials and uploaded spreadsheets, so it must never be committed.
include/*.db
include/*.db-*
include/*.db.*

# Uploaded spreadsheets
include/uploads/*
!include/uploads/.htaccess
!include/uploads/index.html

# Environment and editor clutter
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.log
*.bak
*.tmp
.idea/
.vscode/
