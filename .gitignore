# The seeded SQLite database is committed so a fresh install starts with a
# working schema and the ADMIN account. Runtime sidecar files stay ignored.
include/*.db-*
include/*.db.*

# Uploaded spreadsheets
include/uploads/*
!include/uploads/.htaccess
!include/uploads/index.html

# Environment and editor clutter
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
*.log
*.bak
*.tmp
.idea/
.vscode/
